# Copie para .env (nunca versionado)
DB_PASSWORD=gestao_dev
DATABASE_URL=postgresql+asyncpg://gestao:gestao_dev@db:5432/gestao
APP_VERSION=dev
LOG_JSON=true
TZ_REGRAS=America/Recife
TOLERANCIA_PADRAO_PCT=5

# Autenticação (Keycloak). Mesmo emissor para navegador, web e API.
KEYCLOAK_ADMIN_PASSWORD=admin_dev
OIDC_ISSUER=http://keycloak.localhost:8080/realms/gestao
OIDC_JWKS_URL=http://keycloak.localhost:8080/realms/gestao/protocol/openid-connect/certs
OIDC_AUDIENCE=gestao-api

# Web (Auth.js)
AUTH_SECRET=troque-por-um-valor-aleatorio-de-32-bytes
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=gestao-web
AUTH_KEYCLOAK_SECRET=gestao-web-dev
AUTH_KEYCLOAK_ISSUER=http://keycloak.localhost:8080/realms/gestao
API_URL=http://api:8000

# F06
JIRA_BASE_URL=
JIRA_TOKEN_REF=
# F09
IA_PROVEDOR=simulado
IA_MODELO=
IA_CHAVE_REF=
