{
  "comum": {
    "type": "object",
    "required": ["id", "tipo", "ocorrido_em", "dados"],
    "properties": {
      "id": {"type": "string", "format": "uuid"},
      "tipo": {"type": "string", "enum": ["medicao.registrada", "farol.vermelho", "anomalia.aberta", "acao.vencida", "ritual.encerrado"]},
      "ocorrido_em": {"type": "string", "format": "date-time"},
      "dados": {"type": "object"}
    }
  },
  "farol.vermelho": {
    "type": "object",
    "required": ["indicador_id", "codigo", "periodo", "valor", "setor_id"],
    "properties": {
      "indicador_id": {"type": "string", "format": "uuid"},
      "codigo": {"type": "string"},
      "periodo": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
      "valor": {"type": "number"},
      "setor_id": {"type": "string", "format": "uuid"}
    }
  }
}
