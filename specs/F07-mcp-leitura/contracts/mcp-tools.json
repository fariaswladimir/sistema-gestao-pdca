{
  "servidor": {"nome": "gestao-pdca", "transporte": "streamable-http", "caminho": "/mcp", "auth": "oauth2"},
  "ferramentas": [
    {
      "name": "consultar_arvore",
      "description": "Devolve a árvore de indicadores de um objetivo ou setor no período, com meta, valor, farol e situação SDCA. Use para visão geral.",
      "acao": "indicador:ler",
      "inputSchema": {
        "type": "object",
        "properties": {
          "objetivo_id": {"type": "string", "description": "ID do objetivo (ou informe setor_id)"},
          "setor_id": {"type": "string", "description": "ID do setor (ou informe objetivo_id)"},
          "periodo": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "description": "AAAA-MM; padrão: mês atual"},
          "profundidade": {"type": "integer", "minimum": 1, "maximum": 5, "default": 3}
        }
      }
    },
    {
      "name": "consultar_indicador",
      "description": "Detalha um indicador: tipo, fórmula, meta, série histórica, farol, anomalias e planos ligados.",
      "acao": "indicador:ler",
      "inputSchema": {
        "type": "object",
        "required": ["indicador_id"],
        "properties": {
          "indicador_id": {"type": "string"},
          "meses": {"type": "integer", "minimum": 1, "maximum": 36, "default": 12}
        }
      }
    },
    {
      "name": "listar_pendencias",
      "description": "Lista pendências do usuário conectado (ou do setor, para gestor): ações abertas e vencidas, metas a aceitar, anomalias sem causa raiz, DTOs atrasados.",
      "acao": "indicador:ler",
      "inputSchema": {
        "type": "object",
        "properties": {
          "escopo": {"type": "string", "enum": ["minhas", "setor"], "default": "minhas"},
          "setor_id": {"type": "string"}
        }
      }
    },
    {
      "name": "consultar_padroes",
      "description": "Busca POPs vigentes e lições aprendidas por texto, setor ou indicador.",
      "acao": "indicador:ler",
      "inputSchema": {
        "type": "object",
        "properties": {
          "texto": {"type": "string"},
          "setor_id": {"type": "string"},
          "indicador_id": {"type": "string"},
          "limite": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10}
        }
      }
    }
  ],
  "recursos": ["arvore://objetivo/{id}", "pop://{id}"],
  "prompts": [{"name": "resumo_do_setor", "argumentos": ["setor_id", "periodo"]}]
}
