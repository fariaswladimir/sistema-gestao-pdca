{
  "realm": "gestao",
  "enabled": true,
  "displayName": "Sistema de Gestão PDCA",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(10) and notUsername",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt-BR"
  ],
  "defaultLocale": "pt-BR",
  "clients": [
    {
      "clientId": "gestao-web",
      "name": "Sistema de Gestão (web)",
      "enabled": true,
      "publicClient": false,
      "secret": "${AUTH_KEYCLOAK_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://${HOMOLOG_HOST}/*"
      ],
      "webOrigins": [
        "https://${HOMOLOG_HOST}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${HOMOLOG_HOST}/*"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audiencia-gestao-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "gestao-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "basic"
      ]
    }
  ],
  "users": [
    {
      "username": "ana",
      "email": "ana@exemplo.org",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Ana",
      "lastName": "Exemplo",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_SENHA_INICIAL}",
          "temporary": true
        }
      ],
      "requiredActions": [
        "UPDATE_PASSWORD"
      ]
    },
    {
      "username": "bruno",
