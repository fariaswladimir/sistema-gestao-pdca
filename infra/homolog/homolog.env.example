# Copie para /opt/gestao-pdca/homolog.env no servidor (fora do repositório; nunca versionado).
# Gere cada segredo com: openssl rand -hex 32
HOMOLOG_HOST=gestao-homolog.exemplo.interno

# TLS: "internal" (CA do Caddy) ou, com certificado da organização em CERTS_DIR:
#   CADDY_TLS=/certs/cert.pem /certs/chave.pem
#   NODE_EXTRA_CA_CERTS=/certs/ca-organizacao.pem
CADDY_TLS=internal
CERTS_DIR=/opt/gestao-pdca/certs

DB_PASSWORD=
KC_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
AUTH_SECRET=
AUTH_KEYCLOAK_SECRET=
# Senha inicial dos usuários de demonstração; o Keycloak obriga a troca no primeiro login.
KC_SENHA_INICIAL=

TZ_REGRAS=America/Recife
TOLERANCIA_PADRAO_PCT=5
